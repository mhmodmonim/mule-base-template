<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

	<!--
	  =========================================================================
	  Global error handler
	  =========================================================================
	  Reference it from every flow that owns a message source:

	      <error-handler ref="global-error-handler"/>

	  Contract, per handler block:
	    vars.httpStatus        Integer       status the HTTP listener returns.
	    vars.errorMessage      String        short, client-safe summary.
	    vars.errorDescription  String|Array  detail; falls back to error.description.

	  Everything else - the JSON envelope, the correlation id, the ERROR log
	  line - is produced once in build-error-response-sub-flow. Add new blocks
	  above the ANY block, MOST SPECIFIC FIRST, because Mule matches in
	  document order.

	  All blocks use on-error-propagate so the listener's <http:error-response>
	  serialises the reply. Do not switch to on-error-continue here: that would
	  return HTTP 200 with an error body.
	  =========================================================================
	-->
	<error-handler name="global-error-handler" doc:id="77f85497-bc5a-4406-9826-4708e19ce808">

		<!-- ============== Application-defined errors ============== -->
		<!--
		  Raise these from implementation flows, e.g.
		    <raise-error type="APP:RESOURCE_NOT_FOUND" description="Example ex-9 does not exist"/>
		-->
		<on-error-propagate type="APP:VALIDATION" enableNotifications="true" logException="false" doc:name="APP:VALIDATION - 400">
			<set-variable value="#[400]" variableName="httpStatus" doc:name="Set HTTP Status - 400"/>
			<set-variable value="Bad request" variableName="errorMessage" doc:name="Set Error Message"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="APP:RESOURCE_NOT_FOUND" enableNotifications="true" logException="false" doc:name="APP:RESOURCE_NOT_FOUND - 404">
			<set-variable value="#[404]" variableName="httpStatus" doc:name="Set HTTP Status - 404"/>
			<set-variable value="Not found" variableName="errorMessage" doc:name="Set Error Message"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<!--
		  Two more that most APIs end up needing. They are commented out because
		  Mule only registers an APP:* error type when some <raise-error> in the
		  application actually uses it - uncommenting a handler for a type that
		  is never raised fails the build with "Could not find error 'APP:X'".

		  So: add the <raise-error> in your implementation flow FIRST, then
		  uncomment the matching block here.

		<on-error-propagate type="APP:CONFLICT" enableNotifications="true" logException="false" doc:name="APP:CONFLICT - 409">
			<set-variable value="#[409]" variableName="httpStatus" doc:name="Set HTTP Status - 409"/>
			<set-variable value="Conflict" variableName="errorMessage" doc:name="Set Error Message"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="APP:UNPROCESSABLE" enableNotifications="true" logException="false" doc:name="APP:UNPROCESSABLE - 422">
			<set-variable value="#[422]" variableName="httpStatus" doc:name="Set HTTP Status - 422"/>
			<set-variable value="Unprocessable entity" variableName="errorMessage" doc:name="Set Error Message"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		-->

		<!-- ============== APIkit: inbound contract violations ============== -->
		<on-error-propagate type="APIKIT:BAD_REQUEST" enableNotifications="true" logException="false" doc:name="APIKIT:BAD_REQUEST - 400">
			<set-variable value="#[400]" variableName="httpStatus" doc:name="Set HTTP Status - 400"/>
			<set-variable value="Bad request" variableName="errorMessage" doc:name="Set Error Message"/>
			<!-- APIkit packs every schema violation into one newline-separated string. Split it into an array. -->
			<ee:transform doc:name="Set Error Description">
				<ee:variables>
					<ee:set-variable variableName="errorDescription"><![CDATA[%dw 2.0
output application/java
var raw = (error.description default "") replace "Error validating JSON. Error: " with ""
---
(raw splitBy "\n")
	map ((line) -> trim(line replace /^\s*-\s*/ with ""))
	filter ((line) -> !isEmpty(line))]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="APIKIT:METHOD_NOT_ALLOWED" enableNotifications="true" logException="false" doc:name="APIKIT:METHOD_NOT_ALLOWED - 405">
			<set-variable value="#[405]" variableName="httpStatus" doc:name="Set HTTP Status - 405"/>
			<set-variable value="Method not allowed" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The method specified in the request is not allowed for this resource" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="APIKIT:NOT_ACCEPTABLE" enableNotifications="true" logException="false" doc:name="APIKIT:NOT_ACCEPTABLE - 406">
			<set-variable value="#[406]" variableName="httpStatus" doc:name="Set HTTP Status - 406"/>
			<set-variable value="Not acceptable" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The resource cannot generate a response matching the request Accept headers" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="APIKIT:NOT_FOUND" enableNotifications="true" logException="false" doc:name="APIKIT:NOT_FOUND - 404">
			<set-variable value="#[404]" variableName="httpStatus" doc:name="Set HTTP Status - 404"/>
			<set-variable value="Not found" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The server has not found anything matching the request URI" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="APIKIT:UNSUPPORTED_MEDIA_TYPE" enableNotifications="true" logException="false" doc:name="APIKIT:UNSUPPORTED_MEDIA_TYPE - 415">
			<set-variable value="#[415]" variableName="httpStatus" doc:name="Set HTTP Status - 415"/>
			<set-variable value="Unsupported media type" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The request entity is in a format the resource does not support for this method" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="APIKIT:NOT_IMPLEMENTED" enableNotifications="true" logException="true" doc:name="APIKIT:NOT_IMPLEMENTED - 501">
			<set-variable value="#[501]" variableName="httpStatus" doc:name="Set HTTP Status - 501"/>
			<set-variable value="Not implemented" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The API specification declares this operation but no implementation flow exists" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>

		<!-- ============== HTTP requester: downstream failures ============== -->
		<!--
		  Downstream status codes are deliberately NOT mirrored 1:1. A backend
		  4xx caused by a request WE built is our bug, not the caller's, so it
		  surfaces as 502. Change this per API if your consumers depend on
		  pass-through semantics.
		-->
		<on-error-propagate type="HTTP:UNAUTHORIZED" enableNotifications="true" logException="true" doc:name="HTTP:UNAUTHORIZED - 502">
			<set-variable value="#[502]" variableName="httpStatus" doc:name="Set HTTP Status - 502"/>
			<set-variable value="Bad gateway" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="Authentication against the upstream service failed" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="HTTP:FORBIDDEN" enableNotifications="true" logException="true" doc:name="HTTP:FORBIDDEN - 502">
			<set-variable value="#[502]" variableName="httpStatus" doc:name="Set HTTP Status - 502"/>
			<set-variable value="Bad gateway" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="Access to the upstream service is forbidden" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="HTTP:BAD_REQUEST" enableNotifications="true" logException="true" doc:name="HTTP:BAD_REQUEST - 502">
			<set-variable value="#[502]" variableName="httpStatus" doc:name="Set HTTP Status - 502"/>
			<set-variable value="Bad gateway" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The upstream service rejected the request as malformed" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="HTTP:NOT_FOUND" enableNotifications="true" logException="true" doc:name="HTTP:NOT_FOUND - 502">
			<set-variable value="#[502]" variableName="httpStatus" doc:name="Set HTTP Status - 502"/>
			<set-variable value="Bad gateway" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The upstream resource does not exist" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="HTTP:TOO_MANY_REQUESTS" enableNotifications="true" logException="true" doc:name="HTTP:TOO_MANY_REQUESTS - 429">
			<set-variable value="#[429]" variableName="httpStatus" doc:name="Set HTTP Status - 429"/>
			<set-variable value="Too many requests" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The upstream service is rate limiting this client. Retry later" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="HTTP:TIMEOUT" enableNotifications="true" logException="true" doc:name="HTTP:TIMEOUT - 504">
			<set-variable value="#[504]" variableName="httpStatus" doc:name="Set HTTP Status - 504"/>
			<set-variable value="Gateway timeout" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The upstream service did not respond within the configured timeout" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="HTTP:RETRY_EXHAUSTED" enableNotifications="true" logException="true" doc:name="HTTP:RETRY_EXHAUSTED - 503">
			<set-variable value="#[503]" variableName="httpStatus" doc:name="Set HTTP Status - 503"/>
			<set-variable value="Service unavailable" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="Retries against the upstream service were exhausted" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="HTTP:CONNECTIVITY" enableNotifications="true" logException="true" doc:name="HTTP:CONNECTIVITY - 503">
			<set-variable value="#[503]" variableName="httpStatus" doc:name="Set HTTP Status - 503"/>
			<set-variable value="Service unavailable" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The upstream service is temporarily unreachable" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="HTTP:INTERNAL_SERVER_ERROR" enableNotifications="true" logException="true" doc:name="HTTP:INTERNAL_SERVER_ERROR - 502">
			<set-variable value="#[502]" variableName="httpStatus" doc:name="Set HTTP Status - 502"/>
			<set-variable value="Bad gateway" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The upstream service was unable to fulfil the request" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="HTTP:SERVICE_UNAVAILABLE" enableNotifications="true" logException="true" doc:name="HTTP:SERVICE_UNAVAILABLE - 503">
			<set-variable value="#[503]" variableName="httpStatus" doc:name="Set HTTP Status - 503"/>
			<set-variable value="Service unavailable" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The upstream service is temporarily unavailable" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="HTTP:PARSING" enableNotifications="true" logException="true" doc:name="HTTP:PARSING - 502">
			<set-variable value="#[502]" variableName="httpStatus" doc:name="Set HTTP Status - 502"/>
			<set-variable value="Bad gateway" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The upstream response could not be parsed" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>

		<!-- ============== Runtime-level errors ============== -->
		<on-error-propagate type="STREAM_MAXIMUM_SIZE_EXCEEDED" enableNotifications="true" logException="true" doc:name="STREAM_MAXIMUM_SIZE_EXCEEDED - 413">
			<set-variable value="#[413]" variableName="httpStatus" doc:name="Set HTTP Status - 413"/>
			<set-variable value="Payload too large" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The request or an intermediate stream exceeded the configured buffer size" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="REDELIVERY_EXHAUSTED" enableNotifications="true" logException="true" doc:name="REDELIVERY_EXHAUSTED - 503">
			<set-variable value="#[503]" variableName="httpStatus" doc:name="Set HTTP Status - 503"/>
			<set-variable value="Service unavailable" variableName="errorMessage" doc:name="Set Error Message"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="RETRY_EXHAUSTED" enableNotifications="true" logException="true" doc:name="RETRY_EXHAUSTED - 503">
			<set-variable value="#[503]" variableName="httpStatus" doc:name="Set HTTP Status - 503"/>
			<set-variable value="Service unavailable" variableName="errorMessage" doc:name="Set Error Message"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="CONNECTIVITY" enableNotifications="true" logException="true" doc:name="CONNECTIVITY - 503">
			<set-variable value="#[503]" variableName="httpStatus" doc:name="Set HTTP Status - 503"/>
			<set-variable value="Service unavailable" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="A dependency of this API is temporarily unavailable" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="TIMEOUT" enableNotifications="true" logException="true" doc:name="TIMEOUT - 504">
			<set-variable value="#[504]" variableName="httpStatus" doc:name="Set HTTP Status - 504"/>
			<set-variable value="Gateway timeout" variableName="errorMessage" doc:name="Set Error Message"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="SECURITY" enableNotifications="true" logException="true" doc:name="SECURITY - 401">
			<set-variable value="#[401]" variableName="httpStatus" doc:name="Set HTTP Status - 401"/>
			<set-variable value="Unauthorized" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The request could not be authenticated" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="VALIDATION" enableNotifications="true" logException="true" doc:name="VALIDATION - 400">
			<set-variable value="#[400]" variableName="httpStatus" doc:name="Set HTTP Status - 400"/>
			<set-variable value="Bad request" variableName="errorMessage" doc:name="Set Error Message"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<!--
		  TRANSFORMATION / EXPRESSION / ROUTING are OUR bugs, not the caller's,
		  so they are 500. The detail is logged but not echoed to the client.
		-->
		<on-error-propagate type="TRANSFORMATION" enableNotifications="true" logException="true" doc:name="TRANSFORMATION - 500">
			<set-variable value="#[500]" variableName="httpStatus" doc:name="Set HTTP Status - 500"/>
			<set-variable value="Internal server error" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The server failed to transform a message" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="EXPRESSION" enableNotifications="true" logException="true" doc:name="EXPRESSION - 500">
			<set-variable value="#[500]" variableName="httpStatus" doc:name="Set HTTP Status - 500"/>
			<set-variable value="Internal server error" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The server failed to evaluate an expression" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>
		<on-error-propagate type="ROUTING" enableNotifications="true" logException="true" doc:name="ROUTING - 500">
			<set-variable value="#[500]" variableName="httpStatus" doc:name="Set HTTP Status - 500"/>
			<set-variable value="Internal server error" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The server failed to route the message" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>

		<!-- ============== Catch-all. Must stay last. ============== -->
		<on-error-propagate type="ANY" enableNotifications="true" logException="true" doc:name="ANY - 500">
			<set-variable value="#[500]" variableName="httpStatus" doc:name="Set HTTP Status - 500"/>
			<set-variable value="Internal server error" variableName="errorMessage" doc:name="Set Error Message"/>
			<set-variable value="The server encountered an unexpected condition which prevented it from fulfilling the request" variableName="errorDescription" doc:name="Set Error Description"/>
			<flow-ref name="build-error-response-sub-flow" doc:name="Build Error Response"/>
		</on-error-propagate>

	</error-handler>

	<!--
	  Single place that renders the error envelope and writes the ERROR log.
	  Keep the payload shape in sync with dataTypes.ErrorResponse in the RAML.
	-->
	<sub-flow name="build-error-response-sub-flow" doc:id="4d88dcc6-e89d-4c57-88b3-b5d46d7f3500">
		<logger level="ERROR" category="api.error" doc:name="Log Error" message="#[output application/json --- {event: 'REQUEST_FAILED', correlationId: vars.correlationId default correlationId, application: p('app.name'), environment: p('env'), httpStatus: vars.httpStatus default 500, errorType: (error.errorType.namespace default 'UNKNOWN') ++ ':' ++ (error.errorType.identifier default 'UNKNOWN'), message: vars.errorMessage default 'Internal server error', description: error.description default '', failingComponent: error.failingComponent default 'N/A'}]"/>
		<ee:transform doc:name="Error Response" doc:id="1e9b9ba3-0d9f-42aa-b0e4-fe1e5a0351c1">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json encoding="UTF-8", skipNullOn="everywhere"
---
{
	code: vars.httpStatus default 500,
	message: vars.errorMessage default (error.errorType.identifier default "INTERNAL_SERVER_ERROR"),
	description: vars.errorDescription default (error.description default "No further detail available"),
	dateTime: now() as String { format: "yyyy-MM-dd'T'HH:mm:ss'Z'" },
	correlationId: vars.correlationId default correlationId
}]]></ee:set-payload>
			</ee:message>
			<ee:variables>
				<!-- Marker other flows can check; also resets any stale outbound headers. -->
				<ee:set-variable variableName="errorRaised"><![CDATA[%dw 2.0
output application/java
---
true]]></ee:set-variable>
				<ee:set-variable variableName="outboundHeaders"><![CDATA[%dw 2.0
output application/java
---
(vars.outboundHeaders default {}) ++ { "Content-Type": "application/json" }]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</sub-flow>

</mule>
