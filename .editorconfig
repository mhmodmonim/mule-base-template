# Anypoint Studio writes tab-indented XML. Matching it here keeps hand edits
# and Studio edits from fighting each other in every diff.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{xml,raml}]
indent_style = tab
indent_size = 4

[*.{yaml,yml,json}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.dwl]
indent_style = space
indent_size = 2

[Jenkinsfile]
indent_style = space
indent_size = 4
