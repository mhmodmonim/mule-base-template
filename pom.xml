<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
	  groupId MUST be your Anypoint Platform organization (or business group) id.
	  Exchange rejects publishes whose groupId does not match the target org.
	  Find it under Access Management > Organization.
	-->
    <groupId>ae70f528-2250-49bd-bcca-c9f5cb212bf9</groupId>
    <artifactId>mule-api-base-template</artifactId>
    <version>1.0.2</version>
    <packaging>mule-application</packaging>
    <name>mule-api-base-template</name>
    <description>Mule 4 starter template for new API projects</description>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
        <!-- ===================== Runtime / toolchain ===================== -->
        <app.runtime>4.12.3</app.runtime>
        <java.version>17</java.version>
        <munit.version>3.7.4</munit.version>
        <!-- ===================== Connector versions =====================
		     Pinned deliberately. Never use version ranges or LATEST: a build
		     that resolves differently tomorrow is not reproducible. -->
        <!-- ===================== Deployment defaults =====================
		     Overridden by the dev / test / uat / prod profiles below. -->
        <deployment.env>dev</deployment.env>
        <anypoint.uri>https://anypoint.mulesoft.com</anypoint.uri>
        <anypoint.environment>Sandbox</anypoint.environment>
        <cloudhub.target>Cloudhub-US-East-2</cloudhub.target>
        <cloudhub.replicas>1</cloudhub.replicas>
        <cloudhub.vCores>0.1</cloudhub.vCores>
        <cloudhub.appName>${project.artifactId}-${deployment.env}</cloudhub.appName>
        <cloudhub.deploymentTimeout>1200000</cloudhub.deploymentTimeout>
        <!-- ===================== Test behaviour =====================
		     70% is the target, not what the untouched template achieves: most
		     of the global error handler is unreachable branches that only fire
		     against a real backend, so the template itself sits near 24%.
		     Enforcement is therefore OFF by default - the report still prints
		     the gap on every build. Once your own flows are the bulk of the
		     application, turn it on in CI with:
		         mvn test -Dmunit.coverage.failBuild=true -->
        <munit.coverage.failBuild>false</munit.coverage.failBuild>
        <munit.coverage.application>70</munit.coverage.application>
        <munit.coverage.resource>70</munit.coverage.resource>
        <munit.coverage.flow>70</munit.coverage.flow>
        <!-- Set on the command line or in settings.xml; never hard-code. -->
        <enc.key>__SET_VIA_SETTINGS_XML__</enc.key>
        <api.id>__SET_VIA_SETTINGS_XML__</api.id>
        <!-- Exchange metadata -->
        <tags/>
        <categories>[]</categories>
        <fields>[]</fields>
        <mule.maven.plugin.version>4.10.0</mule.maven.plugin.version>
        <mule.http.connector.version>1.12.1</mule.http.connector.version>
        <mule.sockets.connector.version>1.2.9</mule.sockets.connector.version>
        <mule.apikit.version>1.12.6</mule.apikit.version>
        <mule.secure.props.version>1.3.2</mule.secure.props.version>
        <mule.validation.module.version>2.0.11</mule.validation.module.version>
    </properties>
    <!--
	  =====================================================================
	  Deployment profiles
	  =====================================================================
	  One per environment. They only override Maven properties; the single
	  mule-maven-plugin configuration in <build> consumes them, so there is
	  exactly one place to change deployment behaviour.

	    mvn deploy -Pdev  -DmuleDeploy
	    mvn deploy -Ptest -DmuleDeploy
	    mvn deploy -Puat  -DmuleDeploy
	    mvn deploy -Pprod -DmuleDeploy
	-->
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <deployment.env>dev</deployment.env>
                <anypoint.environment>Sandbox</anypoint.environment>
                <cloudhub.replicas>1</cloudhub.replicas>
                <cloudhub.vCores>0.1</cloudhub.vCores>
            </properties>
        </profile>
        <profile>
            <id>test</id>
            <properties>
                <deployment.env>test</deployment.env>
                <anypoint.environment>Sandbox</anypoint.environment>
                <cloudhub.replicas>1</cloudhub.replicas>
                <cloudhub.vCores>0.1</cloudhub.vCores>
            </properties>
        </profile>
        <profile>
            <id>uat</id>
            <properties>
                <deployment.env>uat</deployment.env>
                <anypoint.environment>UAT</anypoint.environment>
                <cloudhub.replicas>2</cloudhub.replicas>
                <cloudhub.vCores>0.2</cloudhub.vCores>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <deployment.env>prod</deployment.env>
                <anypoint.environment>Production</anypoint.environment>
                <cloudhub.replicas>2</cloudhub.replicas>
                <cloudhub.vCores>0.5</cloudhub.vCores>
                <!-- Production apps drop the environment suffix. -->
                <cloudhub.appName>${project.artifactId}</cloudhub.appName>
            </properties>
        </profile>
    </profiles>
    <build>
        <!--
		  Everything under src/main/resources ships unfiltered - Mule's own
		  ${...} placeholders must survive the build untouched. build-info is
		  the one exception: it is filtered with @ delimiters (configured on
		  maven-resources-plugin below).

		  Keep build-info HERE, not in a separate copy-resources execution.
		  Anypoint Code Builder runs MUnit from a rewritten copy of this pom in
		  a temp folder; it makes <build><resources> paths absolute but leaves
		  plugin-execution paths relative, so an execution-level
		  <directory>src/main/build-info</directory> silently copies nothing
		  and the app fails with "Couldn't find resource: build-info.properties".
		-->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/build-info</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>
            <!-- Fail fast and clearly if the toolchain is wrong. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.8.0,)</version>
                                    <message>Maven 3.8.0+ is required to build this application.</message>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${java.version},18)</version>
                                    <message>Mule ${app.runtime} runs on Java ${java.version}. Point JAVA_HOME at a JDK ${java.version}.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
			  Stamps artifactId/version/build time into build-info.properties
			  (the filtered <resource> above). @-only delimiters, so a ${...}
			  can never be substituted even if filtering is turned on elsewhere.
			-->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                    <delimiters>
                        <delimiter>@</delimiter>
                    </delimiters>
                </configuration>
            </plugin>
            <!--
			  =============================================================
			  Mule packaging + deployment
			  =============================================================
			  Credentials come from settings.xml (a connected app with the
			  Runtime Manager and Exchange scopes), never from this file.
			-->
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <classifier>mule-application</classifier>
                    <cloudhub2Deployment>
                        <uri>${anypoint.uri}</uri>
                        <provider>MC</provider>
                        <muleVersion>${app.runtime}</muleVersion>
                        <javaVersion>${java.version}</javaVersion>
                        <applicationName>${cloudhub.appName}</applicationName>
                        <environment>${anypoint.environment}</environment>
                        <target>${cloudhub.target}</target>
                        <replicas>${cloudhub.replicas}</replicas>
                        <vCores>${cloudhub.vCores}</vCores>
                        <deploymentTimeout>${cloudhub.deploymentTimeout}</deploymentTimeout>
                        <connectedAppClientId>${anypoint.connectedApp.clientId}</connectedAppClientId>
                        <connectedAppClientSecret>${anypoint.connectedApp.clientSecret}</connectedAppClientSecret>
                        <connectedAppGrantType>client_credentials</connectedAppGrantType>
                        <deploymentSettings>
                            <generateDefaultPublicUrl>true</generateDefaultPublicUrl>
                            <updateStrategy>rolling</updateStrategy>
                            <forwardSslSession>false</forwardSslSession>
                            <lastMileSecurity>false</lastMileSecurity>
                        </deploymentSettings>
                        <integrations>
                            <services>
                                <objectStoreV2>
                                    <enabled>true</enabled>
                                </objectStoreV2>
                            </services>
                        </integrations>
                        <properties>
                            <env>${deployment.env}</env>
                            <anypoint.platform.base_uri>https://anypoint.mulesoft.com</anypoint.platform.base_uri>
                            <anypoint.platform.analytics_base_uri>https://analytics-ingest.anypoint.mulesoft.com</anypoint.platform.analytics_base_uri>
                        </properties>
                        <!--
						  Values here are hidden in Runtime Manager because they
						  are listed under secureProperties in mule-artifact.json.
						-->
                        <secureProperties>
                            <enc.key>${enc.key}</enc.key>
                            <api.id>${api.id}</api.id>
                            <anypoint.platform.client_id>${anypoint.platform.client_id}</anypoint.platform.client_id>
                            <anypoint.platform.client_secret>${anypoint.platform.client_secret}</anypoint.platform.client_secret>
                        </secureProperties>
                    </cloudhub2Deployment>
                    <sharedLibraries>
                        <!--
						  JDBC drivers and other libraries the app must load from
						  the container classloader go here, e.g.
						  <sharedLibrary>
						      <groupId>com.mysql</groupId>
						      <artifactId>mysql-connector-j</artifactId>
						  </sharedLibrary>
						-->
                    </sharedLibraries>
                </configuration>
            </plugin>
            <!--
			  =============================================================
			  MUnit
			  =============================================================
			  Runs in the `test` phase. Skip with -DskipMunitTests.
			  Coverage thresholds are enforced only when
			  -Dmunit.coverage.failBuild=true (always on in the prod profile).
			-->
            <plugin>
                <groupId>com.mulesoft.munit.tools</groupId>
                <artifactId>munit-maven-plugin</artifactId>
                <version>${munit.version}</version>
                <executions>
                    <execution>
                        <id>test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                            <goal>coverage-report</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <runtimeVersion>${app.runtime}</runtimeVersion>
                    <argLines>
                        <argLine>-Denv=test</argLine>
                        <argLine>-Denc.key=localDevOnlyKey0</argLine>
                    </argLines>
                    <coverage>
                        <runCoverage>true</runCoverage>
                        <failBuild>${munit.coverage.failBuild}</failBuild>
                        <requiredApplicationCoverage>${munit.coverage.application}</requiredApplicationCoverage>
                        <requiredResourceCoverage>${munit.coverage.resource}</requiredResourceCoverage>
                        <requiredFlowCoverage>${munit.coverage.flow}</requiredFlowCoverage>
                        <formats>
                            <format>html</format>
                            <format>console</format>
                        </formats>
                    </coverage>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>${mule.http.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-sockets-connector</artifactId>
            <version>${mule.sockets.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-apikit-module</artifactId>
            <version>${mule.apikit.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <dependency>
            <groupId>com.mulesoft.modules</groupId>
            <artifactId>mule-secure-configuration-property-module</artifactId>
            <version>${mule.secure.props.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-validation-module</artifactId>
            <version>${mule.validation.module.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <!--
		  Uncomment together with the db:config block in global.xml. Add the
		  matching JDBC driver as a normal dependency AND as a sharedLibrary
		  above, or the driver will not be visible to the connector.

		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-db-connector</artifactId>
			<version>1.14.14</version>
			<classifier>mule-plugin</classifier>
		</dependency>
		-->
        <!-- ===================== Test scope ===================== -->
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-runner</artifactId>
            <version>${munit.version}</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mulesoft.munit</groupId>
            <artifactId>munit-tools</artifactId>
            <version>${munit.version}</version>
            <classifier>mule-plugin</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <repositories>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/nexus/repository/releases/</url>
            <layout>default</layout>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>mulesoft-public</id>
            <name>MuleSoft Public Repository</name>
            <url>https://repository.mulesoft.org/nexus/content/repositories/public/</url>
            <layout>default</layout>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <layout>default</layout>
            <url>https://repository.mulesoft.org/nexus/repository/releases/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
        <pluginRepository>
            <id>mulesoft-public</id>
            <name>MuleSoft Public Repository</name>
            <layout>default</layout>
            <url>https://repository.mulesoft.org/nexus/content/repositories/public/</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>
    <distributionManagement>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Corporate Exchange Repository</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${project.groupId}/maven</url>
            <layout>default</layout>
        </repository>
    </distributionManagement>
</project>
